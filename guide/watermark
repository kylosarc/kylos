<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Watermark — Local-First C2PA Content Credentials Verifier</title>
  <meta name="description" content="Browser-based forensic inspection of C2PA Content Credentials. Verify provenance, detect AI generation, and analyze text — all locally." />
  <link rel="icon" type="image/svg+xml" href="logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* ── Watermark Color Scheme ──────────────────────────────── */
    :root {
      --color-bg: #0c0e11;
      --color-bg-raised: #121417;
      --color-bg-card: #181b1f;
      --color-bg-hover: #1e2126;
      --color-surface: #23272c;
      --color-border: rgba(61, 73, 76, 0.3);
      --color-border-strong: rgba(61, 73, 76, 0.5);
      --color-primary: #4cd7f6;
      --color-primary-dim: rgba(76, 215, 246, 0.12);
      --color-secondary: #d0bcff;
      --color-secondary-dim: rgba(208, 188, 255, 0.1);
      --color-tertiary: #4edea3;
      --color-tertiary-dim: rgba(78, 222, 163, 0.1);
      --color-text: #e8eaed;
      --color-text-dim: #9aa0a6;
      --color-text-muted: #5f6368;
      --color-danger: #f43f5e;
      --color-warning: #f59e0b;
      --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Layout ─────────────────────────────────────────────── */
    .page { display: flex; min-height: 100vh; }

    .sidebar {
      position: fixed;
      top: 0; left: 0;
      width: 280px;
      height: 100vh;
      background: var(--color-bg-raised);
      border-right: 1px solid var(--color-border);
      overflow-y: auto;
      padding: 24px 0;
      z-index: 100;
    }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 20px 20px;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 16px;
    }

    .sidebar-logo img { width: 32px; height: 32px; }

    .sidebar-logo h1 {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--color-text);
      letter-spacing: -0.02em;
    }

    .sidebar-logo .version {
      font-size: 0.625rem;
      font-weight: 500;
      color: var(--color-primary);
      background: var(--color-primary-dim);
      border: 1px solid rgba(76, 215, 246, 0.2);
      border-radius: 4px;
      padding: 1px 6px;
      margin-left: auto;
    }

    .sidebar-section {
      padding: 0 12px;
      margin-bottom: 8px;
    }

    .sidebar-section-title {
      font-size: 0.625rem;
      font-weight: 600;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 8px 8px 4px;
    }

    .sidebar a {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 10px;
      border-radius: 6px;
      color: var(--color-text-dim);
      text-decoration: none;
      font-size: 0.8125rem;
      font-weight: 500;
      transition: all 0.15s;
    }

    .sidebar a:hover {
      color: var(--color-text);
      background: var(--color-bg-hover);
    }

    .sidebar a.active {
      color: var(--color-primary);
      background: var(--color-primary-dim);
    }

    .sidebar .icon {
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .sidebar .icon svg { width: 16px; height: 16px; }

    .main-content {
      margin-left: 280px;
      flex: 1;
      padding: 48px 64px;
      max-width: 900px;
    }

    /* ── Hero ────────────────────────────────────────────────── */
    .hero {
      padding: 32px 0 48px;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 48px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.6875rem;
      font-weight: 500;
      color: var(--color-tertiary);
      background: var(--color-tertiary-dim);
      border: 1px solid rgba(78, 222, 163, 0.2);
      border-radius: 20px;
      padding: 4px 12px;
      margin-bottom: 16px;
    }

    .hero-badge .dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--color-tertiary);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin-bottom: 12px;
    }

    .hero h1 .gradient {
      background: linear-gradient(135deg, var(--color-primary), var(--color-tertiary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero .tagline {
      font-size: 1.125rem;
      color: var(--color-text-dim);
      max-width: 600px;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .hero-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
      cursor: pointer;
      border: none;
    }

    .hero-btn.primary {
      background: var(--color-primary);
      color: var(--color-bg);
    }

    .hero-btn.primary:hover { background: #3cc8e6; }

    .hero-btn.secondary {
      background: var(--color-bg-card);
      color: var(--color-text);
      border: 1px solid var(--color-border);
    }

    .hero-btn.secondary:hover {
      border-color: var(--color-primary);
      background: var(--color-primary-dim);
    }

    /* ── Sections ────────────────────────────────────────────── */
    .section {
      padding: 48px 0;
      border-bottom: 1px solid var(--color-border);
    }

    .section:last-child { border-bottom: none; }

    .section-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px; height: 40px;
      border-radius: 10px;
      margin-bottom: 12px;
    }

    .section-icon.primary { background: var(--color-primary-dim); color: var(--color-primary); }
    .section-icon.secondary { background: var(--color-secondary-dim); color: var(--color-secondary); }
    .section-icon.tertiary { background: var(--color-tertiary-dim); color: var(--color-tertiary); }
    .section-icon.danger { background: rgba(244, 63, 94, 0.1); color: var(--color-danger); }

    .section h2 {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }

    .section .subtitle {
      font-size: 0.875rem;
      color: var(--color-text-dim);
      margin-bottom: 24px;
      max-width: 600px;
    }

    /* ── Feature Cards ───────────────────────────────────────── */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
    }

    .feature-card {
      background: var(--color-bg-card);
      border: 1px solid var(--color-border);
      border-radius: 10px;
      padding: 20px;
      transition: all 0.2s;
    }

    .feature-card:hover {
      border-color: rgba(76, 215, 246, 0.3);
      background: var(--color-bg-hover);
      transform: translateY(-1px);
    }

    .feature-card-icon {
      width: 32px; height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }

    .feature-card-icon svg { width: 18px; height: 18px; }

    .feature-card h3 {
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .feature-card p {
      font-size: 0.75rem;
      color: var(--color-text-dim);
      line-height: 1.5;
    }

    /* ── Code Blocks ─────────────────────────────────────────── */
    .code-block {
      background: var(--color-bg-card);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      overflow: hidden;
      margin: 16px 0;
    }

    .code-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      background: rgba(18, 20, 23, 0.6);
      border-bottom: 1px solid var(--color-border);
      font-size: 0.6875rem;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
    }

    .code-block pre {
      padding: 14px;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      line-height: 1.6;
      color: var(--color-text);
    }

    .code-block code {
      font-family: inherit;
    }

    .kw { color: var(--color-secondary); }
    .str { color: var(--color-tertiary); }
    .fn { color: var(--color-primary); }
    .cmt { color: var(--color-text-muted); }
    .num { color: var(--color-warning); }

    /* ── Spec Table ──────────────────────────────────────────── */
    .spec-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8125rem;
    }

    .spec-table th {
      text-align: left;
      padding: 10px 14px;
      font-weight: 600;
      color: var(--color-text-dim);
      border-bottom: 1px solid var(--color-border);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .spec-table td {
      padding: 10px 14px;
      border-bottom: 1px solid rgba(61, 73, 76, 0.15);
      vertical-align: top;
    }

    .spec-table td:first-child {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-primary);
      white-space: nowrap;
    }

    .spec-table tr:hover td {
      background: rgba(76, 215, 246, 0.03);
    }

    /* ── Format Tags ─────────────────────────────────────────── */
    .format-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .format-tag {
      font-size: 0.6875rem;
      font-weight: 500;
      font-family: var(--font-mono);
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid;
    }

    .format-tag.img { color: var(--color-primary); border-color: rgba(76, 215, 246, 0.3); background: var(--color-primary-dim); }
    .format-tag.vid { color: var(--color-secondary); border-color: rgba(208, 188, 255, 0.3); background: var(--color-secondary-dim); }
    .format-tag.txt { color: var(--color-tertiary); border-color: rgba(78, 222, 163, 0.3); background: var(--color-tertiary-dim); }
    .format-tag.doc { color: var(--color-warning); border-color: rgba(245, 158, 11, 0.3); background: rgba(245, 158, 11, 0.1); }

    /* ── Workflow Steps ──────────────────────────────────────── */
    .workflow-steps {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .workflow-step {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .workflow-num {
      width: 32px; height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
      font-family: var(--font-mono);
      flex-shrink: 0;
      background: var(--color-primary-dim);
      color: var(--color-primary);
      border: 1px solid rgba(76, 215, 246, 0.3);
    }

    .workflow-step h3 {
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .workflow-step p {
      font-size: 0.8125rem;
      color: var(--color-text-dim);
      line-height: 1.5;
    }

    /* ── Tech Stack ──────────────────────────────────────────── */
    .tech-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
    }

    .tech-item {
      background: var(--color-bg-card);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 16px;
    }

    .tech-item h4 {
      font-size: 0.8125rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .tech-item p {
      font-size: 0.75rem;
      color: var(--color-text-dim);
    }

    /* ── Animated Grid Background ────────────────────────────── */
    .grid-bg {
      position: fixed;
      top: 0; left: 280px; right: 0; bottom: 0;
      background-image:
        linear-gradient(rgba(76, 215, 246, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(76, 215, 246, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: -1;
    }

    /* ── Responsive ──────────────────────────────────────────── */
    @media (max-width: 900px) {
      .sidebar { display: none; }
      .main-content { margin-left: 0; padding: 24px; }
      .hero h1 { font-size: 1.75rem; }
      .feature-grid { grid-template-columns: 1fr; }
      .tech-grid { grid-template-columns: 1fr; }
    }

    /* ── Scrollbar ───────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--color-text-muted); }
  </style>
</head>
