    <!-- ── Main Content ───────────────────────────────────── -->
    <main class="main-content">
      <!-- Hero -->
      <section class="hero" id="top">
        <div class="hero-badge"><span class="dot"></span> Local-first — nothing leaves your browser</div>
        <h1><span class="gradient">Watermark</span></h1>
        <p class="tagline">
          Browser-based forensic inspection of <strong>C2PA Content Credentials</strong>.
          Verify provenance, detect AI generation, simulate tampering, and analyze text — all locally via WebAssembly.
        </p>
        <div class="hero-actions">
          <a href="http://localhost:5173" class="hero-btn primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
